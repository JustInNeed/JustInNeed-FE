{
  "name": "justinneed-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint:css": "stylelint \"src/**/*.css\"",
    "api:types": "openapi-typescript https://raw.githubusercontent.com/JustInNeed/JustInNeed-BE/main/openapi.json -o src/lib/api/schema.gen.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "^15.5.2",
    "msw": "2.10.4",
    "openapi-typescript": "7.13.0",
    "stylelint": "^16.26.1",
    "typescript": "^5.6.0",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint",
      "vitest related --run --passWithNoTests"
    ],
    "*.css": [
      "stylelint"
    ]
  }
}
